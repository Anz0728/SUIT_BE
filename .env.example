SUIT_ENV=development
SUIT_DATABASE_URL=sqlite:///./suit.db
SUIT_JWT_SECRET=replace-with-at-least-32-random-characters
SUIT_ACCESS_TOKEN_MINUTES=30
SUIT_BOOTSTRAP_ENABLED=true
SUIT_BOOTSTRAP_TOKEN=replace-with-a-different-32-character-random-token
SUIT_CORS_ORIGINS=["http://localhost:5173","https://suit-woad.vercel.app"]
SUIT_ALLOWED_HOSTS=["localhost","127.0.0.1","testserver"]
SUIT_MAX_REQUEST_BYTES=1048576
SUIT_CLEANUP_INTERVAL_SECONDS=300

